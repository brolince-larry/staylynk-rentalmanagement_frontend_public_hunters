# ── Dev proxy ─────────────────────────────────────────────────────────────────
# Vite forwards /api/* to this host. HTTP_PORT is read by vite.config.ts.
VITE_API_PROXY_TARGET=http://127.0.0.1
HTTP_PORT=80

# ── Frontend API base ─────────────────────────────────────────────────────────
# Requests go directly to the backend (bypasses Vite proxy).
# In production set this to the full API URL, e.g. https://api.staylynk.co.ke
VITE_API_BASE_URL=http://127.0.0.1

# ── AI service auth (optional) ────────────────────────────────────────────────
# Set VITE_AI_INTERNAL_TOKEN to enable X-AI-Internal-Token and HMAC signature headers.
VITE_AI_INTERNAL_TOKEN=

# ── Media CDN ─────────────────────────────────────────────────────────────────
VITE_MEDIA_CDN_URL=

# ── Reverb (WebSocket) ────────────────────────────────────────────────────────
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=80
VITE_REVERB_SCHEME=http
VITE_REVERB_APP_KEY=

# ── Upload limits ─────────────────────────────────────────────────────────────
VITE_PROPERTY_VIDEO_MAX_UPLOAD_KB=102400
